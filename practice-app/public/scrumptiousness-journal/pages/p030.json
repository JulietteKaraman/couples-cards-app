{"n":30,"lines":[[73.79,628.79,107.29,"Marcellus",400,0,9.5,"#ffffff","FEELFULLYYOU.COM "],[40.69,625.93,10.83,"Bodoni",700,1,8.77,"#000000","30"],[104.04,54.16,227.06,"Marcellus",400,0,10.5,"#231f20","I  W O U L D  L O V E  Y O U  T O  D E L V E "],[90.52,73.17,254.11,"Marcellus",400,0,10.5,"#231f20","D E E P E R  I N T O  T H I S  A N D  C R E A T E  A "],[74.94,92.18,282.12,"Marcellus",400,0,10.5,"#231f20","P R A C T I C E  F O R  Y O U R S E L F  O F  F E E L I N G ."],[60.3,159.24,130.25,"Jost",400,0,10.0,"#231f20","Find a comfortable place to lay "],[60.3,173.24,148.59,"Jost",400,0,10.0,"#231f20","down or sit down. Either set a timer "],[60.3,187.24,143.06,"Jost",400,0,10.0,"#231f20","for 10 minutes or allow yourself to "],[60.3,201.24,86.28,"Jost",400,0,10.0,"#231f20","complete the playlist."],[60.3,232.25,135.66,"Jost",400,0,10.0,"#231f20","Listen to the playlist I created for "],[60.3,246.25,124.77,"Jost",400,0,10.0,"#231f20","this exercise. Take a few deep "],[60.3,260.25,142.32,"Jost",400,0,10.0,"#231f20","breaths, in through your nose, out "],[60.3,274.25,77.93,"Jost",400,0,10.0,"#231f20","through the mouth."],[60.3,308.09,140.83,"Jost",400,0,10.0,"#231f20","Quiet the internal noise. Tune into "],[60.3,322.09,37.86,"Jost",400,0,10.0,"#231f20","yourself. "],[98.16,322.09,24.62,"Jost",500,0,10.0,"#231f20","FEEL!"],[60.3,353.1,137.85,"Jost",400,0,10.0,"#231f20","Listen to the language your body "],[60.3,367.1,146.15,"Jost",400,0,10.0,"#231f20","speaks- it may be whispering at the "],[60.3,381.1,44.22,"Jost",400,0,10.0,"#231f20","moment…."],[251.64,159.24,106.55,"Jost",400,0,10.0,"#231f20","Move if you desire, and,  "],[251.64,173.24,72.74,"Jost",400,0,10.0,"#231f20","go to that place…"],[251.64,204.25,118.01,"Jost",400,0,10.0,"#231f20","The place that you feel most "],[251.64,218.25,117.28,"Jost",400,0,10.0,"#231f20","connected, most alive, most "],[251.64,232.25,122.4,"Jost",400,0,10.0,"#231f20","embodied, most scrumptious."],[251.64,263.26,117.32,"Jost",400,0,10.0,"#231f20","When the time you have set "],[251.64,277.26,126.98,"Jost",400,0,10.0,"#231f20","yourself- or the playlist is over, "],[251.64,291.26,144.9,"Jost",400,0,10.0,"#231f20","grab your journal and brain dump, "],[251.64,305.26,144.7,"Jost",400,0,10.0,"#231f20","allow the words to pour out of you "],[251.64,319.26,129.89,"Jost",400,0,10.0,"#231f20","onto the page, no punctuation, "],[251.64,333.26,138.16,"Jost",400,0,10.0,"#231f20","not stopping for anything, just let "],[251.64,347.26,26.6,"Jost",400,0,10.0,"#231f20","it flow."],[251.64,378.27,118.86,"Jost",400,0,10.0,"#231f20","Some of you prefer to voice "],[251.64,392.27,117.81,"Jost",400,0,10.0,"#231f20","record or type; that is totally "],[251.64,406.27,132.1,"Jost",400,0,10.0,"#231f20","cool too. I like to go into nature "],[251.64,420.27,130.38,"Jost",400,0,10.0,"#231f20","immediately afterwards, put my "],[251.64,434.27,143.52,"Jost",400,0,10.0,"#231f20","headphones on and voice record. "]],"areas":[{"id":"p30a1","x":269.21,"y":83.86,"w":8.48,"h":9.32,"n":1,"g":0,"lab":null},{"id":"p30a2","x":323.07,"y":212.32,"w":5.92,"h":5.93,"n":1,"g":0,"lab":null}]}