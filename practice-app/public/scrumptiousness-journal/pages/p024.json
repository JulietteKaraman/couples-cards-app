{"n":24,"lines":[[73.79,628.79,107.29,"Marcellus",400,0,9.5,"#ffffff","FEELFULLYYOU.COM "],[40.56,625.93,11.09,"Bodoni",700,1,8.77,"#000000","24"],[170.8,88.18,91.91,"Marcellus",400,0,23.98,"#ffffff","B O D Y"],[115.32,172.54,215.46,"Marcellus",400,0,10.5,"#ffffff","D O  Y O U  K N O W  T H A T  Y O U R  "],[144.96,191.54,146.72,"Marcellus",400,0,10.5,"#ffffff","B O D Y  I S  A M A Z I N G ? "],[113.22,211.21,207.07,"Jost",500,0,10.0,"#ffffff","It can move, jump, dance, and even talk to you!"],[136.25,225.21,161.0,"Jost",500,0,10.0,"#ffffff","Yet we may not always be listening..."],[68.03,310.0,136.0,"Jost",400,0,8.2,"#ffffff","Body awareness means paying attention "],[68.03,322.0,107.81,"Jost",400,0,8.2,"#ffffff","to what your body is telling you."],[68.03,351.01,130.0,"Jost",400,0,8.2,"#ffffff","When you feel hot or cold, hungry or "],[68.03,363.01,125.97,"Jost",400,0,8.2,"#ffffff","full, or tired or energized, that’s your "],[68.03,375.0,66.66,"Jost",400,0,8.2,"#ffffff","body talking to you."],[68.03,404.01,132.18,"Jost",400,0,8.2,"#ffffff","By noticing these signals, you can start "],[68.03,416.01,130.02,"Jost",400,0,8.2,"#ffffff","to communicate with your body better "],[68.03,428.01,65.68,"Jost",400,0,8.2,"#ffffff","and feel your best. "],[68.03,457.02,132.6,"Jost",400,0,8.2,"#ffffff","You can also learn to appreciate all the "],[68.03,469.02,136.18,"Jost",400,0,8.2,"#ffffff","incredible things your body can do and "],[68.03,481.01,74.32,"Jost",400,0,8.2,"#ffffff","be kinder to yourself. "],[68.03,510.02,114.21,"Jost",400,0,8.2,"#ffffff","So, let’s learn how to listen to our "],[68.03,522.02,55.83,"Jost",400,0,8.2,"#ffffff","amazing bodies!"],[225.92,311.93,53.9,"Jost",500,0,10.0,"#c0a66a","FELT SENSE"],[225.92,328.6,129.04,"Jost",400,0,8.2,"#ffffff","So often we do not exactly know what "],[225.92,339.59,113.08,"Jost",400,0,8.2,"#ffffff","we are feeling in our bodies and "],[225.92,350.59,122.68,"Jost",400,0,8.2,"#ffffff","we often confuse our emotions with "],[225.92,361.59,121.29,"Jost",400,0,8.2,"#ffffff","sensations that are occurring or are "],[225.92,372.58,71.9,"Jost",400,0,8.2,"#ffffff","absent in our bodies."],[225.92,389.25,119.94,"Jost",400,0,8.2,"#ffffff","The lists below start to give you the "],[225.92,400.25,120.39,"Jost",400,0,8.2,"#ffffff","vocabulary to express what you are "],[225.92,411.25,47.41,"Jost",400,0,8.2,"#ffffff","feeling inside."],[225.92,427.92,47.06,"Jost",400,1,8.2,"#ffffff","For Example: "],[225.92,444.59,123.3,"Jost",400,0,8.2,"#ffffff","I feel a smooth, Icy cold pressure in "],[225.92,455.58,130.54,"Jost",400,0,8.2,"#ffffff","my right eyelid. It is static, prickly, and "],[225.92,466.58,126.45,"Jost",400,0,8.2,"#ffffff","metallic. It is grey in colour and feels "],[225.92,477.58,41.22,"Jost",400,0,8.2,"#ffffff","really heavy."],[225.92,494.25,139.17,"Jost",400,0,8.2,"#ffffff","You can probably feel in your body what "],[225.92,505.24,121.63,"Jost",400,0,8.2,"#ffffff","that example would feel like for you!"],[225.92,521.91,134.41,"Jost",400,0,8.2,"#ffffff","This is what we are trying to achieve, to "],[225.92,532.91,126.21,"Jost",400,0,8.2,"#ffffff","be able to communicate what we are "],[225.92,543.91,101.93,"Jost",400,0,8.2,"#ffffff","feeling at each given moment!"]],"areas":[]}